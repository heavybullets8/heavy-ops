{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Keep the major upgrade test fixture on PostgreSQL 17"],
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".tasks/postgres/tests/Dockerfile"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^17\\.\\d+-trixie$/",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": ["PostgreSQL base image for the Patroni infrastructure release"],
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["containers/postgres/Dockerfile"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^\\d+\\.\\d+-trixie$/",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": ["Patroni infrastructure dependency"],
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["containers/postgres/requirements.txt"],
      "matchPackageNames": ["patroni"],
      "automerge": false
    },
    {
      "description": ["Update the home and cloud PostgreSQL release together"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/heavybullets8/postgres-patroni"],
      "groupName": "Patroni PostgreSQL",
      "versioning": "semver",
      "allowedVersions": "/^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": ["Follow stable releases for owned application containers"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/heavybullets8/scale-tv",
        "ghcr.io/heavybullets8/cb-ha-app",
        "ghcr.io/heavybullets8/bighorn-byte-web",
        "ghcr.io/heavybullets8/bighorn-byte-outreach",
        "ghcr.io/heavybullets8/bighorn-byte-browser",
        "ghcr.io/heavybullets8/bighorn-byte-solver"
      ],
      "versioning": "semver",
      "allowedVersions": "/^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": ["Update BighornByte release containers together"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/heavybullets8/bighorn-byte-web",
        "ghcr.io/heavybullets8/bighorn-byte-outreach"
      ],
      "groupName": "BighornByte application",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": ["Promote tested agent runner image pairs and the chart that pins them together"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/heavybullets8/heavy-ops-agent-runner-controller",
        "ghcr.io/heavybullets8/heavy-ops-agent-runner-worker"
      ],
      "enabled": false
    },
    {
      "description": ["Follow tested agent runner chart releases"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/heavybullets8/charts/agent-runner"],
      "versioning": "semver",
      "allowedVersions": "/^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "automerge": false
    },
    {
      "description": ["Custom schedule for frequently updated container digests"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/postgresql/", "/tensorchord/", "postgres", "ghcr.io/heavybullets8/postgres-patroni"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["* 0-3 1 */3 *"],
      "updateNotScheduled": false
    },
    {
      "description": ["Throttle hotio/cloudflareddns digest updates to weekly"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/hotio/cloudflareddns"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["* 0-3 * * 1"],
      "updateNotScheduled": false
    },
    {
      "description": ["PostgreSQL"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "versioning": "loose",
      "allowedVersions": "/^\\d+\\.\\d+-standard-trixie$/"
    },
    {
      "description": ["vchord-scratch"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/tensorchord/vchord-scratch"],
      "versioning": "regex:^pg(?<major>\\d+)-v(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": ["Separate minor and patch updates for Kubernetes"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/siderolabs/kubelet"],
      "separateMajorMinor": true,
      "separateMinorPatch": true
    },
    {
      "description": ["Separate minor and patch updates for Talos"],
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["siderolabs/talos"],
      "separateMajorMinor": true,
      "separateMinorPatch": true
    }
  ]
}
