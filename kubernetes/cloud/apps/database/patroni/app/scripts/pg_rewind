#!/opt/patroni/bin/python
import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import uuid

def target_arg(args):
    for index, value in enumerate(args):
        if value in ('-D', '--target-pgdata'):
            return args[index + 1] if index + 1 < len(args) else None
        if value.startswith('--target-pgdata='):
            return value.split('=', 1)[1]
        if value.startswith('-D') and len(value) > 2:
            return value[2:]
    return None

def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def main():
    args = sys.argv[1:]
    major = os.environ.get('PG_MAJOR', '')
    if not major.isascii() or not major.isdecimal():
        raise RuntimeError('The PostgreSQL image must provide a numeric PG_MAJOR')
    bin_dir = f'/usr/lib/postgresql/{major}/bin'
    real = f'{bin_dir}/pg_rewind'
    pg_ctl = f'{bin_dir}/pg_ctl'
    pg_controldata = f'{bin_dir}/pg_controldata'
    if any(flag in args for flag in ('--help', '-?', '--version', '-V')):
        os.execv(real, [real, *args])
    target_text = target_arg(args)
    if not target_text:
        raise RuntimeError('Refusing rewind without an explicit target PGDATA')
    target = Path(target_text).resolve(strict=True)
    allowed = Path(os.environ.get('HA_REWIND_PGDATA', '/ha-data/postgres')).resolve()
    if target != allowed or not (target / 'PG_VERSION').is_file():
        raise RuntimeError('Rewind target does not match the configured HA data directory')
    if (target / 'PG_VERSION').read_text().strip() != major:
        raise RuntimeError('Rewind target major version does not match the PostgreSQL image')
    quarantine = Path(os.environ.get('HA_REWIND_QUARANTINE', '/ha-forensics')).resolve()
    if quarantine == target or quarantine.is_relative_to(target):
        raise RuntimeError('Quarantine must be outside PGDATA')
    if not quarantine.is_dir() or not quarantine.is_mount():
        raise RuntimeError('Quarantine must be an existing dedicated volume mount')
    if target.stat().st_dev == quarantine.stat().st_dev:
        raise RuntimeError('Quarantine and PGDATA must be on separate filesystems')
    os.chmod(quarantine, 0o700)
    lock = (quarantine / '.snapshot.lock').open('a')
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    status = subprocess.run([pg_ctl, '-D', str(target), 'status'],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if status.returncode != 3:
        raise RuntimeError('PostgreSQL must be stopped before preserving rewind evidence')
    source_bytes = 0
    source_files = 0
    for parent, directories, files in os.walk(target, followlinks=False):
        for name in directories + files:
            path = Path(parent, name)
            if path.is_symlink():
                raise RuntimeError('Symlinked WAL/tablespaces require a separate snapshot implementation')
        for name in files:
            source_bytes += Path(parent, name).stat().st_size
            source_files += 1
    if shutil.disk_usage(quarantine).free < source_bytes + 64 * 1024 * 1024:
        raise RuntimeError('Insufficient quarantine space; rewind is blocked without deleting evidence')
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:12]
    partial = quarantine / (stamp + '.tar.gz.partial')
    final = quarantine / (stamp + '.tar.gz')
    try:
        with partial.open('xb') as raw:
            os.chmod(partial, 0o600)
            with tarfile.open(fileobj=raw, mode='w:gz', compresslevel=1) as archive:
                archive.add(target, arcname='pgdata', recursive=True)
            raw.flush()
            os.fsync(raw.fileno())
        digest = hashlib.sha256()
        with partial.open('rb') as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                digest.update(chunk)
        os.replace(partial, final)
        control = subprocess.run([pg_controldata, str(target)], check=True, capture_output=True, text=True).stdout
        record = {'created_at': dt.datetime.now(dt.timezone.utc).isoformat(),
                  'archive': final.name, 'sha256': digest.hexdigest(),
                  'archive_bytes': final.stat().st_size, 'source_bytes': source_bytes,
                  'source_files': source_files, 'pg_control': control,
                  'includes_pg_wal': True, 'consistency': 'PostgreSQL stopped before archive'}
        metadata = quarantine / (stamp + '.json')
        with metadata.open('x') as output:
            os.chmod(metadata, 0o600)
            json.dump(record, output, indent=2)
            output.write('\n')
            output.flush()
            os.fsync(output.fileno())
        sync_directory(quarantine)
        print(json.dumps({'event': 'pre_rewind_snapshot_durable', 'archive': str(final),
                          'sha256': record['sha256'], 'bytes': record['archive_bytes']}), flush=True)
    except Exception:
        raise
    os.execv(real, [real, *args])

if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Pre-rewind preservation refused: ' + str(error), file=sys.stderr, flush=True)
        sys.exit(1)
